@import 'tailwindcss';

@custom-variant dark (&:is(.dark *));

:root {
  /* Base palette (OKLCH). Contrast ratios were measured, not guessed:
     muted-foreground on background is >= 6.3:1 in both themes. */
  --ink: oklch(0.17 0.03 264);
  --paper: oklch(0.97 0.006 90);
  --lapis: oklch(0.47 0.15 259);
  --gold: oklch(0.8 0.12 88);
  --crimson: oklch(0.58 0.18 26);

  --background: var(--paper);
  --foreground: var(--ink);
  --card: oklch(0.995 0.003 90);
  --card-foreground: var(--ink);
  --popover: var(--card);
  --popover-foreground: var(--ink);
  --primary: var(--lapis);
  --primary-foreground: var(--paper);
  --secondary: oklch(0.93 0.01 90);
  --secondary-foreground: var(--ink);
  --muted: oklch(0.93 0.01 90);
  --muted-foreground: oklch(0.44 0.02 264);
  --accent: oklch(0.93 0.01 90);
  --accent-foreground: var(--ink);
  --destructive: var(--crimson);
  --destructive-foreground: var(--paper);
  --border: oklch(0.86 0.01 90);
  --input: oklch(0.86 0.01 90);
  --ring: var(--lapis);
  --radius: 0.5rem;

  --brand-gold: var(--gold);
  --status-available: oklch(0.62 0.17 150);
}

.dark {
  --background: var(--ink);
  --foreground: oklch(0.96 0.008 90);
  --card: oklch(0.21 0.03 264);
  --card-foreground: oklch(0.96 0.008 90);
  --popover: var(--card);
  --popover-foreground: oklch(0.96 0.008 90);
  /* Lighter blue in dark mode: the light-mode lapis was only 2.8:1 on ink. */
  --primary: oklch(0.74 0.11 259);
  --primary-foreground: var(--ink);
  --secondary: oklch(0.27 0.03 264);
  --secondary-foreground: oklch(0.96 0.008 90);
  --muted: oklch(0.27 0.03 264);
  --muted-foreground: oklch(0.72 0.02 264);
  --accent: oklch(0.27 0.03 264);
  --accent-foreground: oklch(0.96 0.008 90);
  --destructive: oklch(0.7 0.17 26);
  --destructive-foreground: var(--ink);
  --border: oklch(0.32 0.03 264);
  --input: oklch(0.32 0.03 264);
  --ring: var(--primary);
  --status-available: oklch(0.75 0.17 150);
}

@theme inline {
  /* Inter covers Latin; Vazirmatn covers Persian. The browser picks per glyph. */
  --font-sans:
    'Inter Variable', 'Vazirmatn Variable', ui-sans-serif, system-ui, sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

  --color-background: var(--background);
  --color-foreground: var(--foreground);
